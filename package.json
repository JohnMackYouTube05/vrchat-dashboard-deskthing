{
  "name": "vrchat-dashboard",
  "private": true,
  "version": "0.12.1",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:wrapper": "npx @deskthing/cli dev",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:wrapper\"",
    "build": "npx @deskthing/cli package",
    "test": "tsx --test server/*.test.ts",
    "test:package": "node --test scripts/package.test.mjs",
    "typecheck": "tsc -p tsconfig.server.json && tsc -b",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@deskthing/client": "^0.11.1",
    "@deskthing/server": "^0.11.2",
    "autoprefixer": "^10.4.21",
    "axios": "^1.21.1",
    "axios-cookiejar-support": "^5.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.6.2",
    "tough-cookie": "^4.1.4",
    "vrchat": "^1.19.4"
  },
  "devDependencies": {
    "@deskthing/cli": "^0.11.9",
    "@deskthing/types": "^0.11.11",
    "@eslint/js": "^9.9.0",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/tough-cookie": "^4.0.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "esbuild": "^0.19.2",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^16.5.0",
    "tailwindcss": "^3.4.10",
    "tsm": "^2.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.19"
  }
